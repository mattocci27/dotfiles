{
  "$schema": "zed://schemas/settings",
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 0
  },
  "theme": "Gruvbox Material",
  "buffer_font_family": "Cousine",
  "show_whitespaces": "none",
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "relative_line_numbers": "disabled",
  "scrollbar": {
    "show": "never"
  },
  "minimap": {
    "show": "never"
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "inline_code_actions": false,
  "project_panel": {
    "button": false,
    "dock": "left",
    "entry_spacing": "standard",
    "starts_open": false
  },
  "git_panel": {
    "button": false,
    "dock": "left",
    "starts_open": false
  },
  "terminal": {
    "button": false,
    "dock": "bottom",
    "starts_open": false,
    "font_family": "Cousine"
  },
  "debugger": {
    "button": false,
    "dock": "bottom"
  },
  "collaboration_panel": {
    "button": false
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "auto_install_extensions": {
    "air": true,
    "gruvbox-material": true,
    "quarto": true,
    "r": true
  },
  "file_types": {
    "Markdown": [
      "rmd",
      "Rmd"
    ]
  },
  "languages": {
    "Markdown": {
      "format_on_save": "off",
      "soft_wrap": "editor_width"
    },
    "Plain Text": {
      "show_edit_predictions": false,
      "soft_wrap": "editor_width"
    },
    "Quarto": {
      "format_on_save": "off",
      "show_edit_predictions": true,
      "soft_wrap": "editor_width"
    },
    "R": {
      "format_on_save": "on",
      "language_servers": [
        "air",
        "r_language_server"
      ],
      "use_on_type_format": false
    },
    "YAML": {
      "show_edit_predictions": false
    }
  },
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [
      "**/*.md",
      "**/*.markdown",
      "**/*.txt",
      "**/*.yaml",
      "**/*.yml",
      "**/*.MD",
      "**/*.MARKDOWN",
      "**/*.TXT",
      "**/*.YAML",
      "**/*.YML"
    ]
  }
}
