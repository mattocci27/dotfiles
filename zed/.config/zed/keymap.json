[
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "space": null,
      "space e": "project_panel::Toggle",
      "space a a": "agent::Toggle",
      "space a n": "agent::NewThread",
      "space a f": "agent::ToggleFocus",
      "space a m": "agent::ToggleModelSelector",
      "space a c": "agent::AddSelectionToThread",
      "space a d": "agent::OpenAgentDiff",
      "space a s": "agent::OpenSettings",
      "space ;": "command_palette::Toggle",
      "space /": "project_search::ToggleFocus",

      "space b b": "tab_switcher::ToggleAll",
      "space b d": "pane::CloseActiveItem",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",
      "space b u": "pane::ReopenClosedItem",
      "space b o": "pane::CloseOtherItems",
      "space b h": "pane::SplitLeft",
      "space b j": "pane::SplitDown",
      "space b k": "pane::SplitUp",
      "space b l": "pane::SplitRight",

      "space d d": "debugger::Start",
      "space d b": "editor::ToggleBreakpoint",
      "space d c": "debugger::Continue",
      "space d i": "debugger::StepInto",
      "space d n": "debugger::StepOver",
      "space d o": "debugger::StepOut",
      "space d r": "debugger::Restart",
      "space d x": "debugger::Stop",
      "space d p": "debug_panel::Toggle",

      "space f": "file_finder::Toggle",

      "space g g": "git_panel::Toggle",
      "space g d": "git::Diff",
      "space g j": "editor::GoToHunk",
      "space g k": "editor::GoToPreviousHunk",
      "space g s": "git::StageFile",
      "space g shift-s": "git::StageAll",
      "space g u": "git::UnstageFile",
      "space g shift-u": "git::UnstageAll",
      "space g c": "git::Commit",
      "space g b": "git::Branch",
      "space g l": "editor::ToggleGitBlameInline",
      "space g h": "git::FileHistory",
      "space g p": "git::Push",
      "space g shift-p": "git::Pull",

      "space l d": "editor::GoToDefinition",
      "space l shift-d": "editor::GoToDeclaration",
      "space l i": "editor::GoToImplementation",
      "space l r": "editor::FindAllReferences",
      "space l shift-r": "editor::Rename",
      "space l q": "editor::ToggleCodeActions",
      "space l f": "editor::Format",
      "space l n": "editor::GoToDiagnostic",
      "space l shift-n": "editor::GoToPreviousDiagnostic",
      "space l h": "editor::Hover",
      "space l o": "outline::Toggle",
      "space l e": "diagnostics::DeployCurrentFile",
      "space l s": "editor::RestartLanguageServer",

      "space o f": "workspace::Open",
      "space o r": "projects::OpenRecent",
      "space o s": "projects::OpenRemote",
      "space o c": "projects::OpenDevContainer",

      "space q p": [
        "task::Spawn",
        {
          "task_name": "Quarto: preview current document"
        }
      ],
      "space q r": [
        "task::Spawn",
        {
          "task_name": "Quarto: render current document"
        }
      ],
      "space q m": [
        "task::Spawn",
        {
          "task_name": "R Markdown: render current document"
        }
      ],

      "space r p": "diagnostics::Deploy",

      "space t t": "terminal_panel::Toggle",
      "space t f": "terminal_panel::ToggleFocus",
      "space t n": "workspace::NewTerminal",
      "space t r": [
        "task::Spawn",
        {
          "task_name": "R: radian"
        }
      ],

      "space u c": "workspace::ToggleCenteredLayout",
      "space u d": "workspace::ToggleAllDocks",
      "space u f": "zed::ToggleFullScreen",
      "space u t": "theme_selector::Toggle",
      "space u z": "workspace::ToggleEditorZoom",

      "space w": "workspace::Save",
      "space z": "workspace::ToggleZoom",
      "space 0": "pane::CloseActiveItem",

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j j": [
        "workspace::SendKeystrokes",
        "escape"
      ]
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "terminal_panel::ToggleFocus",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::FocusCenterPane",
      "space e": "project_panel::Toggle",
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "o": "project_panel::OpenPermanent",
      "enter": "project_panel::OpenPermanent",
      "/": "project_panel::NewSearchInDirectory",
      "q": "workspace::FocusCenterPane"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": "project_panel::ToggleFocus",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::FocusCenterPane",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-h": "workspace::FocusCenterPane",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  }
]
