{
  "R code chunk": {
    "prefix": "rchunk",
    "body": [
      "```{r ${1:chunk-name}}",
      "$0",
      "```"
    ],
    "description": "Insert an R code chunk"
  },
  "Quarto document setup": {
    "prefix": "quarto-setup",
    "body": [
      "---",
      "title: \"${1:Title}\"",
      "author: \"Masatoshi Katabuchi\"",
      "format:",
      "  html:",
      "    toc: true",
      "    number-sections: true",
      "    embed-resources: true",
      "---",
      "",
      "```{r global-options, include=FALSE}",
      "knitr::opts_chunk\\$set(",
      "  collapse = TRUE,",
      "  comment = \"#>\",",
      "  message = FALSE,",
      "  cache = FALSE,",
      "  fig.align = \"center\"",
      ")",
      "```",
      "",
      "$0"
    ],
    "description": "Insert a compact Quarto header and global R chunk"
  },
  "Load a targets object": {
    "prefix": "loadobjects",
    "body": [
      "withr::with_dir(rprojroot::find_root(\"_targets.R\"), {",
      "  targets::tar_load(${1:object_name})",
      "})",
      "$0"
    ],
    "description": "Load an object from the nearest targets project"
  }
}
