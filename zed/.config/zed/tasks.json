[
  {
    "label": "R: radian",
    "command": "radian",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "hide": "never",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "Quarto: preview current document",
    "command": "quarto",
    "args": [
      "preview",
      "$ZED_FILE"
    ],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  },
  {
    "label": "Quarto: render current document",
    "command": "quarto",
    "args": [
      "render",
      "$ZED_FILE"
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  },
  {
    "label": "R Markdown: render current document",
    "command": "Rscript",
    "args": [
      "-e",
      "rmarkdown::render(commandArgs(trailingOnly = TRUE)[1])",
      "$ZED_FILE"
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  }
]
